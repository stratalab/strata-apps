# Build output
target/
node_modules/
web/pkg/
artifacts/

# Generated Strata databases, which reach tens of gigabytes: colonies-db alone
# is 18G. Matched by shape rather than by name, because the long-running stress
# variants are named per run (pit-db.fat, pit-db.longrun-201012, ...).
*-db/
*-db.*/
*.strata

# Rust
**/*.rs.bk

# A binary's lockfile is not checked in here: every crate in this repo is a
# local stress harness with `publish = false`, and each takes strata-core by
# path, so a committed lock would pin a sibling checkout rather than a release.
Cargo.lock

# Local override for building against a strata-core working tree. See the
# comment above the `stratadb` dependency in each crate.
.cargo/

# Not published yet. strata-pit is still a local stress harness and is not ready
# to be public. It stays on disk and out of this repository until it is.
/strata-pit/
